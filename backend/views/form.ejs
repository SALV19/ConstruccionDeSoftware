<body>
  <section class="section">
    <form action="/plantas/agregar" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label for="planta" class="label">Nombre de la planta</label>
      <input
        class="input"
        type="text"
        placeholder="Orquidea"
        id="planta"
        name="planta"
      />
      <br />
      <br />
      <div class="file">
        <label class="file-label">
          <input
            class="file-input"
            type="file"
            id="image"
            name="image"
            accept=".jpg, .png, .jpeg, .gif"
          />
          <span class="file-cta">
            <span class="file-icon">
              <i class="fas fa-upload"></i>
            </span>
            <span class="file-label"> Choose a file… </span>
          </span>
        </label>
      </div>
      <input
        type="submit"
        value="Enviar"
        action="/otracosa"
        class="button is-info mt-2"
      />
    </form>
  </section>
</body>
