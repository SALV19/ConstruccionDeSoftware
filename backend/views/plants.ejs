<%- include ("./includes/header.ejs") %> <% if (info != "") {%>
<div class="notification is-info"><%= info%></div>
<% } %>

<label class="label" for="buscar">Buscar</label>
<input
  id="buscar"
  name="buscar"
  type="text"
  class="input is-info"
  placeholder="Tulipan"
/>
<div id="container_plantas">

  <div class="is-max-tablet fixed-grid">
    <%for (let p of plantas) {%>
      <div class="card container is-max-tablet cell">
        <a class="card-content" href="/plantas/<%=p.id%>"><%= p.nombre %></a>
      </div>
      <%}%>
    </div>
    
  </div>
  <%- include ("./includes/footer.ejs") %>
    
    <script>
      const buscar = document.querySelector("#buscar");
      buscar.onkeyup = () => {
    fetch(`/plantas/buscar/${buscar.value}`, {
      mehtod: 'GET'
    })
      .then((result) => {
        return result.json()
      })
      .then((data) => {
        // console.log(data)
        const contaienr = document.getElementById('container_plantas');
        container.innerHTML = ``
        let html = '<div class="is-max-tablet fixed-grid">'
        for (let planta of data.plantas) {
          html += `<div class="card container is-max-tablet cell">
                    <a class="card-content" href="/plantas/${planta.imagen}">${planta.nombre}</a>
                  </div>`
        }
      })
      .catch((error) => console.log(error));
  };
</script>
